#!/usr/bin/env bash
set -Eeuo pipefail

ZERO="0000000000000000000000000000000000000000"

# Git exports GIT_DIR into hooks for linked-worktree pushes. Linted tooling that
# creates its own repositories would then write into this checkout, so hand lint
# a plain shell's repository environment.
GIT_REPOSITORY_ENVIRONMENT=(
	GIT_ALTERNATE_OBJECT_DIRECTORIES
	GIT_COMMON_DIR
	GIT_DIR
	GIT_GRAFT_FILE
	GIT_IMPLICIT_WORK_TREE
	GIT_INDEX_FILE
	GIT_NAMESPACE
	GIT_OBJECT_DIRECTORY
	GIT_PREFIX
	GIT_SHALLOW_FILE
	GIT_WORK_TREE
)

run_diff_lint() {
	local range_start="$1"
	local -a scrub_arguments=()
	local variable

	for variable in "${GIT_REPOSITORY_ENVIRONMENT[@]}"; do
		scrub_arguments+=(-u "${variable}")
	done

	# Keep the outer lint entrypoint Git-backed; `path:.#lint` snapshots
	# ignored build output like `target/` and `tmp/` into the store.
	env "${scrub_arguments[@]}" nix --option allow-import-from-derivation false \
		run .#lint -- --diff --base "${range_start}" --system all
}

require_clean_worktree() {
	if [ -n "$(git status --porcelain=v1 --untracked-files=normal)" ]; then
		printf '[pre-push] Refusing to lint a dirty worktree.\n' >&2
		printf '[pre-push] Commit or stash local changes before pushing.\n' >&2
		git status --short --untracked-files=normal >&2
		exit 1
	fi
}

resolve_range_start() {
	local remote_sha="$1" local_sha="$2" local_ref="$3"
	local default_branch base

	if [ "${remote_sha}" = "${ZERO}" ]; then
		default_branch="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null |
			sed 's|^origin/||')"
		: "${default_branch:=master}"
		base="$(git merge-base "origin/${default_branch}" "${local_sha}" 2>/dev/null || true)"
		if [ -z "${base}" ]; then
			printf '[pre-push] Cannot determine merge base for new branch %s, skipping\n' \
				"${local_ref}" >&2
			return 1
		fi
		printf '%s' "${base}"
	else
		printf '%s' "${remote_sha}"
	fi
}

main() {
	local repo_root
	local local_ref local_sha _remote_ref remote_sha
	local range_start commit_count

	printf '[pre-push] Linting changes..\n' >&2

	repo_root="$(git rev-parse --show-toplevel)"
	cd "${repo_root}"
	require_clean_worktree

	while read -r local_ref local_sha _remote_ref remote_sha; do
		if [ "${local_sha}" = "${ZERO}" ]; then
			continue
		fi

		if ! range_start="$(resolve_range_start "${remote_sha}" "${local_sha}" "${local_ref}")"; then
			continue
		fi

		commit_count="$(git rev-list --count "${range_start}..${local_sha}")"
		if [ "${commit_count}" -eq 0 ]; then
			continue
		fi

		printf '[pre-push] Linting files changed across %d commit(s) on %s\n' \
			"${commit_count}" "${local_ref}" >&2

		run_diff_lint "${range_start}"
	done
}

main "$@"
