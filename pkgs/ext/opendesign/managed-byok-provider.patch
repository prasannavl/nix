+      apiProtocolConfigs: {
+        ...(config.apiProtocolConfigs ?? {}),
+        [managed.protocol]: managedApiConfig,
+      },
+      byokProviderConfigDrafts: priorDrafts,
+      byokPendingProviderKey: undefined,
+    },
+  };
+}
