index 0000000..6b23455
--- /dev/null
+++ b/apps/web/tests/state/managed-byok-provider.test.ts
@@ -0,0 +1,138 @@
+// @vitest-environment jsdom
+
+import { beforeEach, describe, expect, it } from 'vitest';
+import { MANAGED_BYOK_PROVIDER } from '../../src/state/managed-byok-provider';
+import {
+  BYOK_PROVIDER_PRESETS,
+  KNOWN_PROVIDERS,
+  loadConfig,
+  saveConfig,
+} from '../../src/state/config';
+import type { AppConfig } from '../../src/types';
+
+const managed = MANAGED_BYOK_PROVIDER;
+const describeManaged = managed ? describe : describe.skip;
+const markerKey = 'abird:open-design:managed-provider';
+
+function providerConfig(overrides: Partial<AppConfig> = {}): AppConfig {
+  return {
+    mode: 'api',
+    apiKey: 'personal-key',
+    baseUrl: 'https://ollama.com',
+    model: 'cloud-model',
+    apiProtocol: 'ollama',
+    apiVersion: '',
+    apiProtocolConfigs: {},
+    apiProviderBaseUrl: 'https://ollama.com',
+    agentId: null,
+    skillId: null,
+    designSystemId: null,
+    onboardingCompleted: true,
+    projectLocations: [],
+    defaultProjectLocationId: 'default',
+    ...overrides,
+  };
+}
+
+describeManaged('managed BYOK provider', () => {
+  beforeEach(() => localStorage.clear());
+
+  it('is the reproducible default for a fresh browser', () => {
+    const config = loadConfig();
+
+    expect(config).toMatchObject({
+      mode: 'api',
+      apiKey: managed?.apiKey,
+      baseUrl: managed?.baseUrl,
+      model: managed?.model,
+      apiProtocol: managed?.protocol,
+      apiProviderBaseUrl: managed?.baseUrl,
+    });
+    expect(KNOWN_PROVIDERS[0]).toMatchObject({
+      label: managed?.label,
+      baseUrl: managed?.baseUrl,
+      requiresApiKey: managed?.requiresApiKey,
+    });
+    expect(BYOK_PROVIDER_PRESETS[0]).toMatchObject({
+      id: managed?.id,
+      title: managed?.title,
+    });
+  });
+
+  it('moves an unversioned browser once and preserves its cloud draft', () => {
+    saveConfig(providerConfig());
+
+    const config = loadConfig();
+
+    expect(config.baseUrl).toBe(managed?.baseUrl);
+    expect(config.model).toBe(managed?.model);
+    expect(
+      config.byokProviderConfigDrafts?.['ollama:https://ollama.com']?.apiConfig,
+    ).toMatchObject({
+      apiKey: 'personal-key',
+      baseUrl: 'https://ollama.com',
+      model: 'cloud-model',
+    });
+  });
+
+  it('preserves a later per-user OpenAI selection', () => {
+    loadConfig();
+    const userConfig = providerConfig({
+      apiProtocol: 'openai',
+      apiProviderBaseUrl: 'https://api.openai.com/v1',
+      baseUrl: 'https://api.openai.com/v1',
+      model: 'gpt-user-choice',
+    });
+    saveConfig(userConfig);
+
+    expect(loadConfig()).toMatchObject({
+      apiKey: 'personal-key',
+      apiProtocol: 'openai',
+      baseUrl: 'https://api.openai.com/v1',
+      model: 'gpt-user-choice',
+    });
+  });
+
+  it('advances only a browser still on the previous managed selection', () => {
+    const previous = {
+      protocol: managed?.protocol ?? 'ollama',
+      baseUrl: 'http://previous.internal:11434',
+      model: 'previous-model',
+    };
+    localStorage.setItem(markerKey, JSON.stringify({
+      revision: 'previous-revision',
+      selection: previous,
+    }));
+    saveConfig(providerConfig({
+      apiKey: managed?.apiKey ?? '',
+      apiProtocol: previous.protocol,
+      apiProviderBaseUrl: previous.baseUrl,
+      baseUrl: previous.baseUrl,
+      model: previous.model,
+    }));
+
+    expect(loadConfig()).toMatchObject({
+      apiProtocol: managed?.protocol,
+      baseUrl: managed?.baseUrl,
+      model: managed?.model,
+    });
+  });
+
+  it('does not advance an explicit user selection on a new revision', () => {
+    localStorage.setItem(markerKey, JSON.stringify({
+      revision: 'previous-revision',
+      selection: {
+        protocol: managed?.protocol,
+        baseUrl: 'http://previous.internal:11434',
+        model: 'previous-model',
+      },
+    }));
+    saveConfig(providerConfig());
+
+    expect(loadConfig()).toMatchObject({
+      apiKey: 'personal-key',
+      baseUrl: 'https://ollama.com',
+      model: 'cloud-model',
+    });
+  });
+});
