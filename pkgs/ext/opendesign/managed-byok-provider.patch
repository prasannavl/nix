diff --git a/apps/web/tests/state/managed-byok-provider.test.ts b/apps/web/tests/state/managed-byok-provider.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/tests/state/managed-byok-provider.test.ts
@@ -0,0 +1,157 @@
+// @vitest-environment jsdom
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { MANAGED_BYOK_PROVIDER } from '../../src/state/managed-byok-provider';
+import {
+  BYOK_PROVIDER_PRESETS,
+  KNOWN_PROVIDERS,
+  loadConfig,
+  saveConfig,
+} from '../../src/state/config';
+import type { AppConfig } from '../../src/types';
+
+const managed = MANAGED_BYOK_PROVIDER;
+const describeManaged = managed ? describe : describe.skip;
+const storageKey = 'open-design:config';
+const markerKey = 'abird:open-design:managed-provider';
+
+function providerConfig(overrides: Partial<AppConfig> = {}): AppConfig {
+  return {
+    mode: 'api',
+    apiKey: 'personal-key',
+    baseUrl: 'https://ollama.com',
+    model: 'cloud-model',
+    apiProtocol: 'ollama',
+    apiVersion: '',
+    apiProtocolConfigs: {},
+    apiProviderBaseUrl: 'https://ollama.com',
+    agentId: null,
+    skillId: null,
+    designSystemId: null,
+    onboardingCompleted: true,
+    projectLocations: [],
+    defaultProjectLocationId: 'default',
+    ...overrides,
+  };
+}
+
+describeManaged('managed BYOK provider', () => {
+  beforeEach(() => localStorage.clear());
+
+  it('seeds and persists only a fresh browser', () => {
+    const config = loadConfig();
+
+    expect(config).toMatchObject({
+      mode: 'api',
+      apiKey: managed?.apiKey,
+      baseUrl: managed?.baseUrl,
+      model: managed?.model,
+      apiProtocol: managed?.protocol,
+      apiProviderBaseUrl: managed?.baseUrl,
+    });
+    expect(JSON.parse(localStorage.getItem(storageKey)!)).toMatchObject({
+      baseUrl: managed?.baseUrl,
+      model: managed?.model,
+    });
+    expect(localStorage.getItem(markerKey)).toBeNull();
+    expect(KNOWN_PROVIDERS[0]).toMatchObject({
+      label: managed?.label,
+      baseUrl: managed?.baseUrl,
+      requiresApiKey: managed?.requiresApiKey,
+    });
+    expect(BYOK_PROVIDER_PRESETS[0]).toMatchObject({
+      id: managed?.id,
+      title: managed?.title,
+    });
+  });
+
+  it('preserves an unmarked personal selection and its key', () => {
+    saveConfig(providerConfig());
+    expect(loadConfig()).toMatchObject(providerConfig());
+    expect(localStorage.getItem(markerKey)).toBeNull();
+  });
+
+  it('keeps a fresh managed selection if persistence is unavailable', () => {
+    const write = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => {
+      throw new Error('quota exceeded');
+    });
+    try {
+      expect(loadConfig()).toMatchObject({
+        baseUrl: managed?.baseUrl,
+        model: managed?.model,
+      });
+    } finally {
+      write.mockRestore();
+    }
+  });
+
+  it('preserves a later per-user OpenAI selection', () => {
+    loadConfig();
+    const personal = providerConfig({
+      apiProtocol: 'openai',
+      apiProviderBaseUrl: 'https://api.openai.com/v1',
+      baseUrl: 'https://api.openai.com/v1',
+      model: 'gpt-user-choice',
+    });
+    saveConfig(personal);
+    expect(loadConfig()).toMatchObject(personal);
+  });
+
+  it('does not infer ownership from an old managed marker or equal selection', () => {
+    const previous = {
+      protocol: managed?.protocol ?? 'ollama',
+      baseUrl: 'http://previous.internal:11434',
+      model: 'previous-model',
+    };
+    const marker = JSON.stringify({ revision: 'old', selection: previous });
+    localStorage.setItem(markerKey, marker);
+    const personal = providerConfig({
+      apiProtocol: previous.protocol,
+      apiProviderBaseUrl: previous.baseUrl,
+      baseUrl: previous.baseUrl,
+      model: previous.model,
+    });
+    saveConfig(personal);
+    expect(loadConfig()).toMatchObject(personal);
+    expect(localStorage.getItem(markerKey)).toBe(marker);
+  });
+
+  it('preserves a personal key even when the selection equals the current default', () => {
+    const personal = providerConfig({
+      apiProtocol: managed?.protocol,
+      apiProviderBaseUrl: managed?.baseUrl,
+      baseUrl: managed?.baseUrl,
+      model: managed?.model,
+    });
+    saveConfig(personal);
+    expect(loadConfig()).toMatchObject(personal);
+  });
+
+  it.each(['', 'invalid JSON'])('does not overwrite existing invalid config %j', (raw) => {
+    localStorage.setItem(storageKey, raw);
+    expect(loadConfig().apiKey).not.toBe(managed?.apiKey);
+    expect(localStorage.getItem(storageKey)).toBe(raw);
+  });
+
+  it('requires an absent config before reseeding, regardless of stale markers', () => {
+    saveConfig(providerConfig());
+    localStorage.setItem(markerKey, 'not authority');
+    localStorage.removeItem(storageKey);
+    expect(loadConfig()).toMatchObject({
+      baseUrl: managed?.baseUrl,
+      model: managed?.model,
+    });
+    expect(localStorage.getItem(markerKey)).toBe('not authority');
+  });
+
+  it('does not assume absence when browser storage is unavailable', () => {
+    const read = vi.spyOn(Storage.prototype, 'getItem').mockImplementation(() => {
+      throw new Error('unavailable');
+    });
+    try {
+      expect(loadConfig().apiKey).not.toBe(managed?.apiKey);
+    } finally {
+      read.mockRestore();
+    }
+  });
+});
