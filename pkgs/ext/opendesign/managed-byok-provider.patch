+interface ManagedProviderMarker {
+  revision: string;
+  selection: {
+    protocol: ApiProtocol;
+    baseUrl: string;
+    model: string;
+  };
+}
+
+function readManagedProviderMarker(): ManagedProviderMarker | null {
+  try {
+    const raw = localStorage.getItem(MANAGED_PROVIDER_STORAGE_KEY);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as Partial<ManagedProviderMarker>;
+    if (
+      typeof parsed.revision !== 'string' ||
+      !parsed.selection ||
+      typeof parsed.selection.protocol !== 'string' ||
+      typeof parsed.selection.baseUrl !== 'string' ||
+      typeof parsed.selection.model !== 'string'
+    ) {
+      return null;
+    }
+    return parsed as ManagedProviderMarker;
+  } catch {
+    return null;
+  }
+}
+
+function managedSelectionMatches(
+  config: AppConfig,
+  selection: ManagedProviderMarker['selection'],
+): boolean {
+  return config.mode === 'api'
+    && config.apiProtocol === selection.protocol
+    && config.baseUrl === selection.baseUrl
+    && config.model === selection.model;
+}
+
+function currentApiConfig(config: AppConfig): ApiProtocolConfig {
+  return {
+    apiKey: config.apiKey,
+    baseUrl: config.baseUrl,
+    model: config.model,
+    apiVersion: config.apiVersion ?? '',
+    apiProviderBaseUrl: config.apiProviderBaseUrl ?? null,
+    byokImageModel: config.byokImageModel ?? '',
+    byokVideoModel: config.byokVideoModel ?? '',
+    byokSpeechModel: config.byokSpeechModel ?? '',
+    byokSpeechVoice: config.byokSpeechVoice ?? '',
+  };
+}
+
+function providerDraftKey(config: AppConfig): string {
+  const protocol = config.apiProtocol ?? 'anthropic';
+  return `${protocol}:${config.apiProviderBaseUrl ?? `custom:${config.baseUrl}`}`;
+}
+
+function applyManagedByokProvider(
+  config: AppConfig,
+  force = false,
+): { config: AppConfig; changed: boolean } {
+  const managed = MANAGED_BYOK_PROVIDER;
+  if (!managed) return { config, changed: false };
+
+  const marker = readManagedProviderMarker();
+  const selection = {
+    protocol: managed.protocol,
+    baseUrl: managed.baseUrl,
+    model: managed.model,
+  };
+  const shouldApply = force
+    || marker === null
+    || (
+      marker.revision !== managed.revision
+      && managedSelectionMatches(config, marker.selection)
+    );
+
+  try {
+    localStorage.setItem(
+      MANAGED_PROVIDER_STORAGE_KEY,
+      JSON.stringify({ revision: managed.revision, selection }),
+    );
+  } catch {
+    // The managed default still applies for this session when storage is unavailable.
+  }
+
+  if (!shouldApply) return { config, changed: false };
+
+  const priorDrafts = config.mode === 'api'
+    ? {
+        ...(config.byokProviderConfigDrafts ?? {}),
+        [providerDraftKey(config)]: {
+          apiConfig: currentApiConfig(config),
+          maxTokens: config.maxTokens,
+        },
+      }
+    : config.byokProviderConfigDrafts;
+  const managedApiConfig: ApiProtocolConfig = {
+    apiKey: managed.apiKey,
+    baseUrl: managed.baseUrl,
+    model: managed.model,
+    apiVersion: '',
+    apiProviderBaseUrl: managed.baseUrl,
+  };
+
+  return {
+    changed: true,
+    config: {
