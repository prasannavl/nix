{
  buildNpmPackage,
  lib,
  makeWrapper,
  nodejs_22,
}: let
  source = (import ./sources.nix).mcpvault;
  # `runtime/` is generated by ./update.sh: it depends on the exact npm release,
  # so one lock pins the published app and its dependency closure. Upstream's
  # own lock is bun-generated and lacks `resolved`/`integrity` entries.
  lock = lib.importJSON ./runtime/package-lock.json;
  lockedVersion = lock.packages."node_modules/${source.package}".version or null;
  packageRoot = "lib/node_modules/${source.package}";
in
  assert lib.assertMsg (lockedVersion == source.version)
  "mcpvault: runtime lock pins ${toString lockedVersion}, sources.nix ${source.version}; run update.sh";
    buildNpmPackage {
      pname = "mcpvault";
      version = source.version;

      src = ./runtime;

      nodejs = nodejs_22;
      npmDepsHash = source.npmDepsHash;
      dontNpmBuild = true;

      nativeBuildInputs = [makeWrapper];

      installPhase = ''
        runHook preInstall

        mkdir -p $out/lib
        cp -R node_modules $out/lib/node_modules

        # Node >= 22.12 is required by upstream's engines field.
        makeWrapper ${lib.getExe nodejs_22} $out/bin/mcpvault \
          --add-flags $out/${packageRoot}/dist/server.js

        runHook postInstall
      '';

      meta = {
        description = "Local MCP server for reading and editing an Obsidian vault";
        homepage = "https://github.com/${source.owner}/${source.repo}";
        license = lib.licenses.mit;
        mainProgram = "mcpvault";
        platforms = lib.platforms.all;
      };
    }
