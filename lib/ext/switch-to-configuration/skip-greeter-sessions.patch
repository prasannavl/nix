+fn only_greeter_sessions<'a>(classes: impl IntoIterator<Item = &'a str>) -> bool {
+    let mut found_greeter = false;
+
+    for class in classes {
+        match class {
+            "greeter" => found_greeter = true,
+            // Every user manager has a synthetic manager session. It does not
+            // make a greeter user eligible for changed-unit reconciliation.
+            "manager" | "manager-early" => {}
+            _ => return false,
+        }
+    }
+
+    found_greeter
+}
+
+fn user_has_only_greeter_sessions(
+    dbus_conn: &LocalConnection,
+    user_dbus_path: &dbus::Path<'_>,
+) -> Result<bool> {
+    let user = dbus_conn.with_proxy(
+        "org.freedesktop.login1",
+        user_dbus_path,
+        Duration::from_millis(5000),
+    );
+    let sessions: Vec<(String, dbus::Path<'static>)> = user
+        .get("org.freedesktop.login1.User", "Sessions")
+        .context("Failed to get logind user sessions")?;
+    let mut classes = Vec::with_capacity(sessions.len());
+
+    for (id, path) in sessions {
+        let session = dbus_conn.with_proxy(
+            "org.freedesktop.login1",
+            path,
+            Duration::from_millis(5000),
+        );
+        let class: String = session
+            .get("org.freedesktop.login1.Session", "Class")
+            .with_context(|| format!("Failed to get class for logind session {id}"))?;
+        classes.push(class);
+    }
+
+    Ok(only_greeter_sessions(classes.iter().map(String::as_str)))
+}
